# =============================================================================
# Build context exclusions.
#
# NOTE: web/ must NOT be excluded — the backend target copies it and serves it
# as the client. Excluding it makes COPY fail with a confusing "not found".
# =============================================================================

# --- Secrets: never enter the build context ---------------------------------
# Injected at runtime via env_file instead, so they never persist in an image
# layer where `docker history` would expose them.
.env
.env.*
!.env.example
.logfire/

# --- Virtual environments (gigabytes, and host-platform specific) ------------
.venv/
venv/
env/
genv/
enterprise_env/
tenvv/

# --- Python artifacts --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
dist/
wheels/

# --- Corpus and generated data ----------------------------------------------
# DATA/ is bind-mounted read-only by the ingest service rather than copied;
# processed_data/ is regenerated by the processor.
DATA/
processed_data/

# --- Not needed by any runtime target ---------------------------------------
# evals/ and tools/ are NOT excluded: the eval image copies them, and excluding
# them is what previously made the evaluation suite impossible to containerise.
DOCS/
notebooks/
*.md
!README.md

# --- Tooling / VCS -----------------------------------------------------------
.git/
.gitignore
.github/
.vscode/
.idea/
.claude/
.python-version
pyproject.toml

# --- Docker's own files ------------------------------------------------------
Dockerfile
docker-compose*.yml
.dockerignore

# --- OS noise ----------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
