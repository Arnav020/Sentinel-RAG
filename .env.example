# ==============================================================================
# Sentinel-RAG configuration
#
# NOTE: use KEY=value with NO spaces around '='. python-dotenv tolerates
# 'KEY = value', but Docker's --env-file parser does not: it reads the name as
# 'KEY ' (trailing space) and refuses to start.
#
# Only the three under "Required" are needed to run. Everything else has a
# working default; the tunables are listed so an experiment never needs a code
# change.
# ==============================================================================

# --- Required -----------------------------------------------------------------
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=
GROQ_API_KEY=

# --- Vector store -------------------------------------------------------------
QDRANT_COLLECTION=kubernetes_docs
QDRANT_TIMEOUT=60

# --- Models -------------------------------------------------------------------
# The Llama family this project was originally built on (llama-3.3-70b-versatile,
# llama-3.1-8b-instant) has been withdrawn from Groq and now returns 404. These
# are the replacements; each draws on its own rate-limit bucket.
GENERATION_MODEL=openai/gpt-oss-120b
PLANNER_MODEL=openai/gpt-oss-20b
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
INJECTION_CONFIRM_MODEL=openai/gpt-oss-safeguard-20b
TOPIC_FILTER_MODEL=openai/gpt-oss-safeguard-20b
EMBEDDING_MODEL=all-mpnet-base-v2

# --- Retrieval ----------------------------------------------------------------
# RERANK_THRESHOLD is the abstention decision and the single most consequential
# number here. Derive it with `python -m tools.calibrate_threshold`; do not guess.
RETRIEVAL_CANDIDATES=60
RETRIEVAL_TOP_N=5
RERANK_THRESHOLD=0.35
RERANK_RELATIVE_FLOOR=0.02
# Used only when the cross-encoder is unavailable and scores fall back to cosine,
# which is a different scale. Deliberately conservative.
VECTOR_FALLBACK_THRESHOLD=0.55

# --- Chunking (ingestion only) ------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
CHUNK_MIN_SIZE=120

# --- API security -------------------------------------------------------------
# Comma-separated. Leave empty to disable auth (correct for local dev and CI).
# /health reports whether auth is on, so a deployment cannot be unprotected
# without that being visible.
API_KEYS=
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_ENABLED=true

# --- LLM gateway (optional) ---------------------------------------------------
# Off by default. A saved Portkey Config referenced by PORTKEY_CONFIG_SLUG
# overrides the model this code requests, and the existing saved config still
# targets the withdrawn Llama models. Turn this on only once that is fixed.
USE_GATEWAY=false
PORTKEY_API_KEY=
PORTKEY_CONFIG_SLUG=
# Evaluation must never score a cached generation.
GATEWAY_CACHE_ENABLED=true

# --- Evaluation ---------------------------------------------------------------
# The judge must be a different model family from GENERATION_MODEL or the system
# grades its own lineage; Settings.validate() enforces this and will refuse to
# start otherwise.
JUDGE_MODEL=qwen/qwen3.8-27b
JUDGE_GROQ=

# --- Observability ------------------------------------------------------------
LOGFIRE_TOKEN=
LOGFIRE_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sentinel-rag

# --- Answer-presence gate ------------------------------------------------------
# Catches what the relevance threshold cannot: a cross-encoder scores topical
# relatedness, not whether an answer is present. Fails OPEN.
ENTAILMENT_GATE_ENABLED=true
ENTAILMENT_MODEL=openai/gpt-oss-safeguard-20b
ENTAILMENT_TOP_K=3
